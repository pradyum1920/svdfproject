# ============================================================
# SVDF Backend - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# JWT Secret Keys (use strong random strings in production)
JWT_SECRET=svdf_super_secret_jwt_key_change_in_production_2024
JWT_REFRESH_SECRET=svdf_refresh_secret_change_in_production_2024
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS - Frontend URL
CLIENT_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Simulation Settings
MAX_LOG_ENTRIES=1000
ALERT_RETENTION_HOURS=24
